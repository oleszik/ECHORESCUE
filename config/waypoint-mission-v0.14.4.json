{
  "schema_version": "echorescue-waypoint-mission-stack/1.0",
  "milestone": "v0.14.4",
  "base_stack_config": "config/simulator-stack-v0.14.0.json",
  "diagnostic_interface": "echorescue_interfaces/msg/EchoRescueVehicleState3D",
  "require_converted_state": true,
  "runner": {
    "node_name": "/echorescue_mavlink_waypoint_mission",
    "observer_node_name": "/echorescue_waypoint_mission_observer",
    "endpoint": "tcp:127.0.0.1:5760",
    "stream_rate_hz": 10,
    "freshness_threshold_s": 1.0,
    "disconnect_threshold_s": 3.0,
    "reconnect_interval_s": 1.0,
    "command": [
      "{transport_python}", "-m", "echorescue_ros.mavlink_waypoint_mission",
      "--output", "{mission_output}", "--ros-args",
      "-p", "endpoint:={mavlink_endpoint}",
      "-p", "stream_rate_hz:={stream_rate_hz}",
      "-p", "freshness_threshold_s:={freshness_threshold_s}",
      "-p", "disconnect_threshold_s:={disconnect_threshold_s}",
      "-p", "reconnect_interval_s:={reconnect_interval_s}",
      "-p", "takeoff_altitude_m:={takeoff_altitude_m}",
      "-p", "waypoint_a_east_m:={waypoint_a_east_m}",
      "-p", "waypoint_a_north_m:={waypoint_a_north_m}",
      "-p", "waypoint_a_up_m:={waypoint_a_up_m}",
      "-p", "waypoint_b_east_m:={waypoint_b_east_m}",
      "-p", "waypoint_b_north_m:={waypoint_b_north_m}",
      "-p", "waypoint_b_up_m:={waypoint_b_up_m}",
      "-p", "return_east_m:={return_east_m}",
      "-p", "return_north_m:={return_north_m}",
      "-p", "return_up_m:={return_up_m}",
      "-p", "horizontal_tolerance_m:={horizontal_tolerance_m}",
      "-p", "vertical_tolerance_m:={vertical_tolerance_m}",
      "-p", "settling_time_s:={settling_time_s}",
      "-p", "target_timeout_s:={target_timeout_s}",
      "-p", "progress_timeout_s:={progress_timeout_s}",
      "-p", "progress_epsilon_m:={progress_epsilon_m}",
      "-p", "mission_timeout_s:={mission_timeout_s}",
      "-p", "geofence_horizontal_radius_m:={geofence_horizontal_radius_m}",
      "-p", "geofence_min_altitude_m:={geofence_min_altitude_m}",
      "-p", "geofence_max_altitude_m:={geofence_max_altitude_m}",
      "-p", "preflight_hold_s:={preflight_hold_s}",
      "-p", "ready_timeout_s:={ready_timeout_s}",
      "-p", "transition_timeout_s:={transition_timeout_s}",
      "-p", "takeoff_timeout_s:={takeoff_timeout_s}",
      "-p", "landing_timeout_s:={landing_timeout_s}",
      "-p", "cleanup_timeout_s:={cleanup_timeout_s}"
    ]
  },
  "mission": {
    "takeoff_altitude_m": 2.0,
    "waypoint_a_east_m": 3.0,
    "waypoint_a_north_m": 0.0,
    "waypoint_a_up_m": 2.0,
    "waypoint_b_east_m": 3.0,
    "waypoint_b_north_m": 3.0,
    "waypoint_b_up_m": 2.5,
    "return_east_m": 0.0,
    "return_north_m": 0.0,
    "return_up_m": 2.0,
    "horizontal_tolerance_m": 0.45,
    "vertical_tolerance_m": 0.35,
    "settling_time_s": 2.0,
    "target_timeout_s": 35.0,
    "progress_timeout_s": 10.0,
    "progress_epsilon_m": 0.15,
    "mission_timeout_s": 180.0,
    "geofence_horizontal_radius_m": 8.0,
    "geofence_min_altitude_m": -0.25,
    "geofence_max_altitude_m": 4.0,
    "preflight_hold_s": 30.0,
    "ready_timeout_s": 45.0,
    "transition_timeout_s": 15.0,
    "takeoff_timeout_s": 35.0,
    "landing_timeout_s": 40.0,
    "cleanup_timeout_s": 40.0
  },
  "topics": {
    "/echorescue/mavlink/vehicle_state": "echorescue_interfaces/msg/MavlinkVehicleState",
    "/echorescue/mavlink/local_position_ned": "echorescue_interfaces/msg/MavlinkLocalPositionNed",
    "/echorescue/mavlink/status": "echorescue_interfaces/msg/MavlinkTelemetryStatus",
    "/echorescue/vehicle/state_3d": "echorescue_interfaces/msg/EchoRescueVehicleState3D",
    "/echorescue/mission/active_target": "echorescue_interfaces/msg/WaypointTarget",
    "/echorescue/mission/event": "echorescue_interfaces/msg/WaypointMissionEvent"
  },
  "observer": {
    "command": [
      "ros2", "run", "echorescue_ros", "waypoint_mission_observer",
      "--output", "{observer_output}",
      "--timeout", "{observer_timeout_s}",
      "--horizontal-tolerance", "{horizontal_tolerance_m}",
      "--vertical-tolerance", "{vertical_tolerance_m}",
      "--settling-time", "{settling_time_s}"
    ]
  },
  "logging": {"failure_log_max_bytes": 65536}
}
