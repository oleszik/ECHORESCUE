<window>
  <width>1920</width>
  <height>1080</height>
  <dialog_on_exit>false</dialog_on_exit>
</window>

<plugin filename="MinimalScene" name="3D View">
  <gz-gui>
    <title>EchoRescue portfolio view</title>
    <property type="bool" key="showTitleBar">false</property>
    <property type="string" key="state">docked</property>
  </gz-gui>
  <engine>ogre2</engine>
  <scene>scene</scene>
  <ambient_light>0.55 0.55 0.55</ambient_light>
  <background_color>0.08 0.10 0.14</background_color>
  <camera_pose>-13 -15 15 0 0.60 0.86</camera_pose>
</plugin>
