<?xml version="1.0"?>
<sdf version="1.9">
  <world name="echorescue_indoor_v0_14_5">
    <physics name="1ms" type="ignore">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-contact-system" name="gz::sim::systems::Contact"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>
    <plugin filename="gz-sim-navsat-system" name="gz::sim::systems::NavSat"/>

    <scene>
      <ambient>0.65 0.65 0.65</ambient>
      <background>0.18 0.20 0.24</background>
      <grid>true</grid>
    </scene>
    <spherical_coordinates>
      <latitude_deg>-35.363262</latitude_deg>
      <longitude_deg>149.165237</longitude_deg>
      <elevation>584</elevation>
      <heading_deg>0</heading_deg>
      <surface_model>EARTH_WGS84</surface_model>
    </spherical_coordinates>
    <light type="directional" name="indoor_sun">
      <pose>0 0 8 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.4 0.2 -0.9</direction>
      <cast_shadows>true</cast_shadows>
    </light>

    <!-- All dimensions below are mirrored by config/indoor-reference-v0.14.5.json. -->
    <model name="floor">
      <static>true</static><pose>0 0 -0.05 0 0 0</pose><link name="link">
        <collision name="collision"><geometry><box><size>12 8 0.1</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>12 8 0.1</size></box></geometry><material><ambient>0.32 0.34 0.38 1</ambient><diffuse>0.42 0.44 0.48 1</diffuse></material></visual>
        <sensor name="contact" type="contact"><always_on>true</always_on><update_rate>50</update_rate><contact><collision>collision</collision><topic>/echorescue/indoor/contacts/floor</topic></contact></sensor>
      </link>
    </model>
    <model name="ceiling">
      <static>true</static><pose>0 0 4.55 0 0 0</pose><link name="link">
        <collision name="collision"><geometry><box><size>12 8 0.1</size></box></geometry></collision>
        <visual name="visual"><transparency>0.65</transparency><geometry><box><size>12 8 0.1</size></box></geometry><material><ambient>0.55 0.58 0.65 0.35</ambient><diffuse>0.55 0.58 0.65 0.35</diffuse></material></visual>
        <sensor name="contact" type="contact"><always_on>true</always_on><update_rate>50</update_rate><contact><collision>collision</collision><topic>/echorescue/indoor/contacts/ceiling</topic></contact></sensor>
      </link>
    </model>

    <model name="wall_west"><static>true</static><pose>-6.05 0 2.25 0 0 0</pose><link name="link">
      <collision name="collision"><geometry><box><size>0.1 8 4.5</size></box></geometry></collision><visual name="visual"><geometry><box><size>0.1 8 4.5</size></box></geometry><material><ambient>0.18 0.32 0.55 1</ambient><diffuse>0.22 0.42 0.72 1</diffuse></material></visual>
      <sensor name="contact" type="contact"><always_on>true</always_on><update_rate>50</update_rate><contact><collision>collision</collision><topic>/echorescue/indoor/contacts/wall_west</topic></contact></sensor>
    </link></model>
    <model name="wall_east"><static>true</static><pose>6.05 0 2.25 0 0 0</pose><link name="link">
      <collision name="collision"><geometry><box><size>0.1 8 4.5</size></box></geometry></collision><visual name="visual"><geometry><box><size>0.1 8 4.5</size></box></geometry><material><ambient>0.18 0.32 0.55 1</ambient><diffuse>0.22 0.42 0.72 1</diffuse></material></visual>
      <sensor name="contact" type="contact"><always_on>true</always_on><update_rate>50</update_rate><contact><collision>collision</collision><topic>/echorescue/indoor/contacts/wall_east</topic></contact></sensor>
    </link></model>
    <model name="wall_south"><static>true</static><pose>0 -4.05 2.25 0 0 0</pose><link name="link">
      <collision name="collision"><geometry><box><size>12 0.1 4.5</size></box></geometry></collision><visual name="visual"><geometry><box><size>12 0.1 4.5</size></box></geometry><material><ambient>0.18 0.32 0.55 1</ambient><diffuse>0.22 0.42 0.72 1</diffuse></material></visual>
      <sensor name="contact" type="contact"><always_on>true</always_on><update_rate>50</update_rate><contact><collision>collision</collision><topic>/echorescue/indoor/contacts/wall_south</topic></contact></sensor>
    </link></model>
    <model name="wall_north"><static>true</static><pose>0 4.05 2.25 0 0 0</pose><link name="link">
      <collision name="collision"><geometry><box><size>12 0.1 4.5</size></box></geometry></collision><visual name="visual"><geometry><box><size>12 0.1 4.5</size></box></geometry><material><ambient>0.18 0.32 0.55 1</ambient><diffuse>0.22 0.42 0.72 1</diffuse></material></visual>
      <sensor name="contact" type="contact"><always_on>true</always_on><update_rate>50</update_rate><contact><collision>collision</collision><topic>/echorescue/indoor/contacts/wall_north</topic></contact></sensor>
    </link></model>

    <model name="divider_south"><static>true</static><pose>0 -2.6 2.25 0 0 0</pose><link name="link">
      <collision name="collision"><geometry><box><size>0.1 2.8 4.5</size></box></geometry></collision><visual name="visual"><geometry><box><size>0.1 2.8 4.5</size></box></geometry><material><ambient>0.22 0.38 0.62 1</ambient><diffuse>0.28 0.50 0.80 1</diffuse></material></visual>
      <sensor name="contact" type="contact"><always_on>true</always_on><update_rate>50</update_rate><contact><collision>collision</collision><topic>/echorescue/indoor/contacts/divider_south</topic></contact></sensor>
    </link></model>
    <model name="divider_north"><static>true</static><pose>0 2.6 2.25 0 0 0</pose><link name="link">
      <collision name="collision"><geometry><box><size>0.1 2.8 4.5</size></box></geometry></collision><visual name="visual"><geometry><box><size>0.1 2.8 4.5</size></box></geometry><material><ambient>0.22 0.38 0.62 1</ambient><diffuse>0.28 0.50 0.80 1</diffuse></material></visual>
      <sensor name="contact" type="contact"><always_on>true</always_on><update_rate>50</update_rate><contact><collision>collision</collision><topic>/echorescue/indoor/contacts/divider_north</topic></contact></sensor>
    </link></model>
    <model name="divider_header"><static>true</static><pose>0 0 3.85 0 0 0</pose><link name="link">
      <collision name="collision"><geometry><box><size>0.1 2.4 1.3</size></box></geometry></collision><visual name="visual"><geometry><box><size>0.1 2.4 1.3</size></box></geometry><material><ambient>0.22 0.38 0.62 1</ambient><diffuse>0.28 0.50 0.80 1</diffuse></material></visual>
      <sensor name="contact" type="contact"><always_on>true</always_on><update_rate>50</update_rate><contact><collision>collision</collision><topic>/echorescue/indoor/contacts/divider_header</topic></contact></sensor>
    </link></model>

    <model name="blocking_obstacle"><static>true</static><pose>2.5 0 1.2 0 0 0</pose><link name="link">
      <collision name="collision"><geometry><box><size>1.5 2 2.4</size></box></geometry></collision><visual name="visual"><geometry><box><size>1.5 2 2.4</size></box></geometry><material><ambient>0.75 0.26 0.08 1</ambient><diffuse>0.95 0.36 0.10 1</diffuse></material></visual>
      <sensor name="contact" type="contact"><always_on>true</always_on><update_rate>50</update_rate><contact><collision>collision</collision><topic>/echorescue/indoor/contacts/blocking_obstacle</topic></contact></sensor>
    </link></model>

    <include>
      <uri>model://iris_with_gimbal</uri>
      <pose>-4 0 0.195 0 0 1.5707963267948966</pose>
    </include>
  </world>
</sdf>
