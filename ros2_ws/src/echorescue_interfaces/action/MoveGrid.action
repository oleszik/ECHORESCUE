# One cardinal, atomic grid-cell movement.
string session_id
string agent_id
string command_id
uint64 expected_state_sequence
builtin_interfaces/Time issued_at
builtin_interfaces/Time valid_until
int32 source_x
int32 source_y
int32 target_x
int32 target_y
---
uint8 ACCEPTED=0
uint8 COMPLETED=1
uint8 REJECTED=2
uint8 CANCELED=3
uint8 FAILED=4
string session_id
string agent_id
string command_id
uint8 status
uint64 state_sequence
builtin_interfaces/Time completed_at
int32 actual_x
int32 actual_y
string detail
---
