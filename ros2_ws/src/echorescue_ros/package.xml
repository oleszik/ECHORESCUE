<?xml version="1.0"?>
<package format="3">
  <name>echorescue_ros</name>
  <version>0.14.1</version>
  <description>ROS 2 adapters for EchoRescue and receive-only MAVLink telemetry.</description>
  <maintainer email="maintainers@example.invalid">EchoRescue contributors</maintainer>
  <license>MIT</license>
  <exec_depend>echorescue_interfaces</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>python3-pymavlink</exec_depend>
  <test_depend>ament_pytest</test_depend>
  <export><build_type>ament_python</build_type></export>
</package>
